datas = [('app.py', '.'), ('apc_engine.py', '.'), ('logigramme.py', '.'), ('rnfc_connector.py', '.'), ('cloud_auth.py', '.'), ('data', 'data'), ('PHOTOS', 'PHOTOS')]
binaries = []
hiddenimports = []
